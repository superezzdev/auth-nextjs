# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Application Domain (used for email verification links)
# In Vercel, this can be your production domain or will fallback automatically to VERCEL_PROJECT_PRODUCTION_URL
DOMAIN=http://localhost:3000

# Mailtrap / SMTP Credentials (for email verification & password resets)
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_KEY=your_mailtrap_password
